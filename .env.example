# Dataset roots (required by every command that reads annotations)
VIDSTG_ROOT=/data/vidstg                 # <root>/annotations/{train,val,test}_annotations.json
VIDOR_ANN_ROOT=/data/vidor/annotation    # <root>/{training,validation}/<folder>/<vid>.json
VIDOR_VIDEO_ROOT=/data/vidor/video       # <root>/<folder>/<vid>.mp4 (the annotation's video_path)
# Optional: H.264 re-encodes written by `vidstg-masks transcode`; searched before VIDOR_VIDEO_ROOT
VIDOR_TRANSCODED_ROOT=/data/vidor/video_h264

# Model inputs
SAM31_REPO_ROOT=/path/to/vidstg-masks/external/sam3
SAM31_CHECKPOINT=/path/to/vidstg-masks/checkpoints/sam3.1/sam3.1_multiplex.pt

# Campaign output directory (records/, claims/, errors/, runs/, export/)
CAMPAIGN_ROOT=/outputs/vidstg-masks-val

# Caches (pip, Hugging Face downloads); keep this off a quota-limited $HOME. Default <repo>/.cache
VIDSTG_MASKS_CACHE_ROOT=/path/to/vidstg-masks/.cache

# Slurm defaults (submit_slurm.sh)
SLURM_PARTITION=your_gpu_partition
SLURM_ACCOUNT=your_account
GPU_GRES=gpu:1
NUM_WORKERS=8
TIME_LIMIT=12:00:00
SIGNAL_LEAD_SECONDS=1800     # USR1 this long before the limit: stop claiming clips, requeue
STAGE_CHECKPOINT=1           # copy the checkpoint to node-local disk once per node (needs 5 GiB free)
ROOTS_FROM_ENV=0             # 1: compute nodes read the roots above, not the paths frozen in worklist.json
