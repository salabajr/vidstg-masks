# The whole dataset (6,770 videos, 44,808 records; about 1,250-3,100 GPU-h on an A5000) on a Slurm GPU array.
# On the login node:  set -a; source examples/all.env; set +a; bash scripts/submit_slurm.sh
# Re-run the same two lines after every walltime to resume. Progress:  vidstg-masks status --worklist "$CAMPAIGN_ROOT/worklist.json" --campaign-root "$CAMPAIGN_ROOT"
VIDSTG_ROOT=/data/vidstg
VIDOR_ANN_ROOT=/data/vidor/annotation
VIDOR_VIDEO_ROOT=/data/vidor/video
VIDOR_TRANSCODED_ROOT=/data/vidor/video_h264
SAM31_REPO_ROOT=/path/to/vidstg-masks/external/sam3
SAM31_CHECKPOINT=/path/to/vidstg-masks/checkpoints/sam3.1/sam3.1_multiplex.pt
PYTHON_BIN=/path/to/vidstg-masks/.venv/bin/python
VIDSTG_MASKS_CACHE_ROOT=/path/to/scratch/vidstg-masks-cache
SPLIT=all
CAMPAIGN_ROOT=/path/to/outputs/vidstg-masks-all
SLURM_PARTITION=your_gpu_partition
SLURM_ACCOUNT=your_account
GPU_GRES=gpu:1
NUM_WORKERS=16
TIME_LIMIT=12:00:00
CPUS_PER_TASK=8
MEMORY=48G
SIGNAL_LEAD_SECONDS=1800
STAGE_CHECKPOINT=1
EXPORT_TIME_LIMIT=02:00:00
EXPORT_MEMORY=32G
ANCHOR_POLICY=human_gap
MAX_ANCHORS=16
CONTAINED_NEGATIVES=1
# DIRECTION=both DISPUTE_RULE=higher_score DISPUTE_SCORE=0.907 DISPUTE_WINNER=strong   # backward pass + the measured dispute tie-break
# ROOTS_FROM_ENV=1      # compute nodes mount the data at other paths than the login node
# ASSERT_COUNTS=0       # partial copy of the dataset: skip the release-count assertion
