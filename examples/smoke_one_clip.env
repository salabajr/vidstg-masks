# One clip on one GPU via scripts/run_local.sh (doctor -> build-worklist -> process -> export).
# On a GPU node:  set -a; source examples/smoke_one_clip.env; set +a; bash scripts/run_local.sh
# Then:  vidstg-masks render --vid 5107391081 --campaign-root "$CAMPAIGN_ROOT"   # overlays/<vid>.mp4
VIDSTG_ROOT=/data/vidstg
VIDOR_ANN_ROOT=/data/vidor/annotation
VIDOR_VIDEO_ROOT=/data/vidor/video
VIDOR_TRANSCODED_ROOT=/data/vidor/video_h264
SAM31_REPO_ROOT=/path/to/vidstg-masks/external/sam3
SAM31_CHECKPOINT=/path/to/vidstg-masks/checkpoints/sam3.1/sam3.1_multiplex.pt
PYTHON_BIN=/path/to/vidstg-masks/.venv/bin/python
VIDSTG_MASKS_CACHE_ROOT=/path/to/scratch/vidstg-masks-cache
SPLIT=val
VIDS=5107391081
CAMPAIGN_ROOT=/path/to/vidstg-masks/outputs/smoke
ANCHOR_POLICY=human_gap
MAX_ANCHORS=16
CONTAINED_NEGATIVES=1
