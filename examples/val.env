# The val split (602 videos, 3,996 records; about 120 GPU-h on an A5000, half that with DIRECTION=forward) on a Slurm GPU array.
# On the login node:  set -a; source examples/val.env; set +a; bash scripts/submit_slurm.sh
# Re-run the same two lines to resume. Progress:  vidstg-masks status --worklist "$CAMPAIGN_ROOT/worklist.json" --campaign-root "$CAMPAIGN_ROOT"
# Every variable and its default: docs/SLURM.md.

# Data roots (docs/DATASETS.md); VIDOR_TRANSCODED_ROOT is where `vidstg-masks transcode` writes repaired videos
VIDSTG_ROOT=/data/vidstg
VIDOR_ANN_ROOT=/data/vidor/annotation
VIDOR_VIDEO_ROOT=/data/vidor/video
VIDOR_TRANSCODED_ROOT=/data/vidor/video_h264

# Model and interpreter (scripts/setup.sh, scripts/download_model.sh); caches off $HOME
SAM31_REPO_ROOT=/path/to/vidstg-masks/external/sam3
SAM31_CHECKPOINT=/path/to/vidstg-masks/checkpoints/sam3.1/sam3.1_multiplex.pt
PYTHON_BIN=/path/to/vidstg-masks/.venv/bin/python
VIDSTG_MASKS_CACHE_ROOT=/path/to/scratch/vidstg-masks-cache

# Which clips, and where the campaign lives (worklist, records, runs, export, slurm_logs)
SPLIT=val
CAMPAIGN_ROOT=/path/to/outputs/vidstg-masks-val

# Slurm: one array task = one GPU = one shard; SLURM_ACCOUNT is passed only when set
SLURM_PARTITION=your_gpu_partition
SLURM_ACCOUNT=your_account
GPU_GRES=gpu:1
NUM_WORKERS=8
TIME_LIMIT=12:00:00
CPUS_PER_TASK=8                 # also caps the tasks per node where --mem is not enforced (docs/SLURM.md, Sizing)
MEMORY=48G
SIGNAL_LEAD_SECONDS=1800        # USR1 this long before the limit: stop claiming clips, finish the active one, requeue
STAGE_CHECKPOINT=1              # copy the checkpoint to node-local disk once per node (0 where /tmp is RAM)

# Prompts (README, Settings that change the masks); these are the defaults, spelled out
ANCHOR_POLICY=human_gap
MAX_ANCHORS=16
CONTAINED_NEGATIVES=1

# Passes and the merge: the defaults are the measured setting,
#   DIRECTION=both DISPUTE_RULE=higher_score DISPUTE_SCORE=0.907 DISPUTE_WINNER=strong
# The forward pass alone, at half the GPU time:
# DIRECTION=forward DISPUTE_RULE=refuse

# Other hosts and partial data
# ROOTS_FROM_ENV=1      # compute nodes mount the data at other paths than the login node
# ASSERT_COUNTS=0       # partial copy of the dataset: skip the release-count assertion
